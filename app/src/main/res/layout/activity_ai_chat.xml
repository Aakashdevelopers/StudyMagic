<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootViewChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#212121"
    android:orientation="vertical">

    <!-- ChatGPT Style Top Header Bar -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#171717"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/baseline_arrow_back_ios_24"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Model Selection Pill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#2F2F2F"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#3E3E3E"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_ai_sparkle"
                        app:tint="#10A37F" />

                    <TextView
                        android:id="@+id/tvModelTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="ChatGPT 4o • AI Mentor"
                        android:textColor="#ECECF1"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClearChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear Chat"
            android:padding="10dp"
            android:src="@drawable/ic_refresh"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Suggestion Chips Scroll Container -->
    <HorizontalScrollView
        android:id="@+id/svSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestExplain"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="💡 Explain Q1 in detail"
                android:textColor="#ECECF1"
                android:textSize="12sp"
                app:chipBackgroundColor="#2F2F2F"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:chipStrokeColor="#3E3E3E"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestMistakes"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="❓ Why were my answers wrong?"
                android:textColor="#ECECF1"
                android:textSize="12sp"
                app:chipBackgroundColor="#2F2F2F"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:chipStrokeColor="#3E3E3E"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestStrategy"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🎯 How to score 100%?"
                android:textColor="#ECECF1"
                android:textSize="12sp"
                app:chipBackgroundColor="#2F2F2F"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:chipStrokeColor="#3E3E3E"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestMotivate"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🔥 Motivate me!"
                android:textColor="#ECECF1"
                android:textSize="12sp"
                app:chipBackgroundColor="#2F2F2F"
                app:chipCornerRadius="16dp"
                app:chipMinHeight="36dp"
                app:chipStrokeColor="#3E3E3E"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>

    </HorizontalScrollView>

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_chat_ai" />

    <!-- ChatGPT Thinking Indicator -->
    <LinearLayout
        android:id="@+id/llChatLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true"
            app:indicatorColor="#10A37F"
            app:indicatorSize="16dp"
            app:trackThickness="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="ChatGPT is thinking..."
            android:textColor="#8E8E93"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- ChatGPT Input Section Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#171717"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#2F2F2F"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="#3E3E3E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_ai_sparkle"
                    app:tint="#10A37F" />

                <EditText
                    android:id="@+id/etChatMessage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Message ChatGPT..."
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="5"
                    android:paddingVertical="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8E8E93"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendChat"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="#10A37F"
                    app:cornerRadius="20dp"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#FFFFFF" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="ChatGPT can make mistakes. Verify important info."
            android:textColor="#8E8E93"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>