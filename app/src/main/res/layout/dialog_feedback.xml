<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="16dp"
    app:cardBackgroundColor="@color/surfaceColor"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeColor="@color/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Section with Waves and Star Badge -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <!-- Golden Waves Graphic Background -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bg_feedback_header_wave" />

            <!-- Centered Circular Badge with Cute Star Graphic -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="bottom|center_horizontal"
                app:cardBackgroundColor="@color/surfaceColor"
                app:cardCornerRadius="40dp"
                app:cardElevation="6dp"
                app:strokeColor="@color/surfaceColor"
                app:strokeWidth="3dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_star_character" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Main Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="How Would You Rate Our\nApp Experience?"
                android:textColor="@color/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Hindi Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="ऐप का अनुभव कैसा रहा?"
                android:textColor="@color/textSecondary"
                android:textSize="12sp" />

            <!-- 5-Star Rating Bar -->
            <RatingBar
                android:id="@+id/ratingBarFeedback"
                style="@style/Widget.AppCompat.RatingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:numStars="5"
                android:progressBackgroundTint="@color/colorOutline"
                android:progressTint="@color/colorSecondary"
                android:rating="0"
                android:stepSize="1" />

            <!-- Optional Feedback Comment Box -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReview"
                style="@style/Widget.Material3.TextInputLayout.FilledBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Leave a comment (Optional) / विचार लिखें..."
                app:boxBackgroundColor="@color/surfaceVariant"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="1dp"
                app:endIconMode="clear_text">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:maxLength="400"
                    android:maxLines="3"
                    android:minLines="2"
                    android:textColor="@color/textPrimary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Pill-Shaped Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitFeedback"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="Submit / सबमिट करें"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="26dp" />

            <!-- Text Button No Thanks / Cancel -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelFeedback"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No, Thanks! / बाद में"
                android:textAllCaps="false"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
